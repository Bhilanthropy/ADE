// Cloudflare settings for the ADE Crew Map.
// "name" must match the name of your Worker in the Cloudflare dashboard.
{
  "name": "ade",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  // Publish the site on <name>.<your-subdomain>.workers.dev
  "workers_dev": true,
  "preview_urls": true,
  // Keep variables added in the Cloudflare dashboard (like CREW_CODE) when a new version deploys.
  "keep_vars": true,
  "d1_databases": [
    {
      // The database is created automatically on the first deploy.
      "binding": "DB",
      "database_name": "ade-crew"
    }
  ]
}
